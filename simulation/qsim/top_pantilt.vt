end 
// hex_c_o[ 4 ]
initial
begin
	hex_c_o[4] = 1'bX;
end 
// hex_c_o[ 3 ]
initial
begin
	hex_c_o[3] = 1'bX;
end 
// hex_c_o[ 2 ]
initial
begin
