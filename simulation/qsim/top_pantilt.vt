			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port hex_sel_o[3] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", hex_sel_o_expected_prev);
		$display ("     Real value = %b", hex_sel_o_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_hex_sel_o_exp[3] = hex_sel_o_expected_prev[3];
	end
	if (
		( hex_sel_o_expected_prev[4] !== 1'bx ) && ( hex_sel_o_prev[4] !== hex_sel_o_expected_prev[4] )
		&& ((hex_sel_o_expected_prev[4] !== last_hex_sel_o_exp[4]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port hex_sel_o[4] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", hex_sel_o_expected_prev);
		$display ("     Real value = %b", hex_sel_o_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_hex_sel_o_exp[4] = hex_sel_o_expected_prev[4];
	end
	if (
		( hex_sel_o_expected_prev[5] !== 1'bx ) && ( hex_sel_o_prev[5] !== hex_sel_o_expected_prev[5] )
		&& ((hex_sel_o_expected_prev[5] !== last_hex_sel_o_exp[5]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port hex_sel_o[5] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", hex_sel_o_expected_prev);
		$display ("     Real value = %b", hex_sel_o_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_hex_sel_o_exp[5] = hex_sel_o_expected_prev[5];
	end
	if (
		( hex_sel_o_expected_prev[6] !== 1'bx ) && ( hex_sel_o_prev[6] !== hex_sel_o_expected_prev[6] )
		&& ((hex_sel_o_expected_prev[6] !== last_hex_sel_o_exp[6]) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port hex_sel_o[6] :: @time = %t",  $realtime);
		$display ("     Expected value = %b", hex_sel_o_expected_prev);
		$display ("     Real value = %b", hex_sel_o_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_hex_sel_o_exp[6] = hex_sel_o_expected_prev[6];
	end
	if (
		( servo_pan_o_expected_prev !== 1'bx ) && ( servo_pan_o_prev !== servo_pan_o_expected_prev )
		&& ((servo_pan_o_expected_prev !== last_servo_pan_o_exp) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port servo_pan_o :: @time = %t",  $realtime);
		$display ("     Expected value = %b", servo_pan_o_expected_prev);
		$display ("     Real value = %b", servo_pan_o_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_servo_pan_o_exp = servo_pan_o_expected_prev;
	end
	if (
		( servo_til_o_expected_prev !== 1'bx ) && ( servo_til_o_prev !== servo_til_o_expected_prev )
		&& ((servo_til_o_expected_prev !== last_servo_til_o_exp) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port servo_til_o :: @time = %t",  $realtime);
		$display ("     Expected value = %b", servo_til_o_expected_prev);
		$display ("     Real value = %b", servo_til_o_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_servo_til_o_exp = servo_til_o_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module top_pantilt_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk_i;
reg rst_i;
reg uart_rx_i;
// wires                                               
wire [6:0] hex_a_o;
wire [6:0] hex_b_o;
wire [6:0] hex_c_o;
wire [6:0] hex_sel_o;
wire servo_pan_o;
wire servo_til_o;

wire sampler;                             

// assign statements (if any)                          
top_pantilt i1 (
// port map - connection between master ports and signals/registers   
	.clk_i(clk_i),
	.hex_a_o(hex_a_o),
	.hex_b_o(hex_b_o),
	.hex_c_o(hex_c_o),
	.hex_sel_o(hex_sel_o),
	.rst_i(rst_i),
	.servo_pan_o(servo_pan_o),
	.servo_til_o(servo_til_o),
	.uart_rx_i(uart_rx_i)
);

// clk_i
always
begin
	clk_i = 1'b0;
	clk_i = #10000 1'b1;
	#10000;
end 
// hex_a_o[ 6 ]
initial
begin
	hex_a_o[6] = 1'bX;
end 
// hex_a_o[ 5 ]
initial
begin
	hex_a_o[5] = 1'bX;
end 
